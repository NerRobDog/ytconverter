# YTConverter API Configuration

# API Keys (comma-separated list)
# Leave empty for open mode (no authentication required)
# Example: YTCONVERTER_API_KEYS=key1,key2,key3
YTCONVERTER_API_KEYS=

# CORS Origins (comma-separated list, or "*" for all)
# Production: YTCONVERTER_CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
# Development: YTCONVERTER_CORS_ORIGINS=*
YTCONVERTER_CORS_ORIGINS=*

# Optional: Redis URL for future caching implementation
# REDIS_URL=redis://localhost:6379
